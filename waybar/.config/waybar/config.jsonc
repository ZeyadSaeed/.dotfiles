{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
        "hyprland/workspaces"
    ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/discord-volume",
    "pulseaudio",
    "custom/vpn",
    "custom/wifi",
    "bluetooth",
    "custom/agents",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}"
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    // "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    // "format": "{:%m:%d - %H:%M}"
    "format": "{:%B %d | %I:%M:%S %p}",
    "interval": 1,
    "on-click": "qs ipc call menu close",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/wifi": {
    "format": "{text}",
    "exec": "~/.config/waybar/scripts/wifi-status.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/waybar/scripts/qs-menu.sh wifi"
  },
  "custom/vpn": {
    "format": "{text}",
    "exec": "~/.config/waybar/scripts/vpn-status.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/waybar/scripts/qs-menu.sh vpn"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/qs-menu.sh bluetooth"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; qs ipc call menu close"
  },
  "custom/discord-volume": {
      "format": "{text}",
      "exec": "~/.config/waybar/scripts/discord-volume.sh",
      "return-type": "json",
      "interval": 5,
      "on-click": "~/.config/hypr/scripts/mute_dis.sh; qs ipc call menu close",
      "on-scroll-up": "~/.config/hypr/scripts/inc_vol_dis.sh",
      "on-scroll-down": "~/.config/hypr/scripts/dec_vol_dis.sh",
      "tooltip": false
  },
  "custom/agents": {
    "format": "{text}",
    "exec": "~/.config/waybar/scripts/agents-status.sh",
    "return-type": "json",
    "interval": 300,
    "on-click": "~/.config/waybar/scripts/qs-menu.sh agents"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/qs-menu.sh power"
  },
    "later": {
        "format": "<span class='icon'>{icon}</span> <span class='text'>{text}</span>"
    }

}
